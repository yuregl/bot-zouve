DISCORD_TOKEN=coloque_o_token_do_bot_aqui
# Optional: debug, info (default), warn, or error.
LOG_LEVEL=info
# Optional: log file path (default logs/bot.log). Leave empty to log to the console only.
LOG_FILE=logs/bot.log
# Optional: seconds with nothing playing or queued before the bot leaves the voice channel (default 300).
IDLE_TIMEOUT_SECONDS=300
# Optional: seconds with no one but bots in the voice channel before the bot leaves it (default 180).
ALONE_TIMEOUT_SECONDS=180
# Optional: seconds a vote to skip stays open (default 60).
SKIP_VOTE_TIMEOUT_SECONDS=60
# MongoDB, which stores birthdays. Docker Compose creates this user on the first start.
# Use letters and numbers only in the password, since it goes into a connection string.
MONGO_USERNAME=zouve
MONGO_PASSWORD=coloque_uma_senha_aqui
# Connection string for `npm run dev` on this computer; Docker Compose sets its own for the bot container.
MONGODB_URI=mongodb://zouve:coloque_uma_senha_aqui@localhost:27017/zouve?authSource=admin
# Comma-separated role names (any case) or role IDs allowed to use /birthday set, like admin,Moderador.
BIRTHDAY_MANAGER_ROLES=admin
# Optional: time birthdays are announced in #zouve-music, as HH:MM in São Paulo time (default 09:00).
BIRTHDAY_ANNOUNCE_TIME=09:00
