{
  "name": "bot-zouve",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "start": "node --env-file=.env dist/index.js",
    "test": "node --experimental-test-module-mocks --import tsx --test \"test/**/*.test.ts\"",
    "test:coverage": "node --experimental-test-module-mocks --import tsx --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "prism-media": "^1.3.5",
    "youtube-dl-exec": "^3.1.17"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.6.4",
    "lefthook": "^2.1.17",
    "oxlint": "^1.86.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
